---
const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'publications', label: 'Publications' },
  { id: 'education', label: 'Education' },
];
---

<nav class="section-nav" aria-label="Page sections">
  <ul>
    {sections.map((section) => (
      <li>
        <a href={`#${section.id}`} data-section-link={section.id}>
          <span class="dot" aria-hidden="true"></span>
          <span class="label">{section.label}</span>
        </a>
      </li>
    ))}
  </ul>
  <span class="active-chip" data-active-chip aria-hidden="true"></span>
</nav>

<style>
  .section-nav {
    position: fixed;
    top: 50%;
    /* Anchor to the left gutter of the centered content column (max-w-[42rem]),
       so it never collides with the text as the viewport narrows. */
    right: calc(50% + 21rem + 2.5rem);
    transform: translateY(-50%);
    z-index: 50;
  }

  .section-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .section-nav a {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.625rem;
    text-decoration: none;
    /* ≥44px tap target for the primary section navigation (WCAG 2.5.5). */
    min-height: 44px;
    min-width: 44px;
    padding: 0 0.25rem;
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 2px solid var(--color-text-muted);
    background-color: transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .section-nav a:hover .dot,
  .section-nav a:focus-visible .dot {
    border-color: var(--color-accent);
    transform: scale(1.15);
  }

  .section-nav a:hover .label,
  .section-nav a:focus-visible .label {
    color: var(--color-text);
  }

  .section-nav a.is-active .dot {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .section-nav a.is-active .label {
    color: var(--color-text);
    font-weight: 600;
  }

  /* Dots that currently overlap the deep-pine hero flip to light styling so
     they stay legible; the rest keep the dark-on-white treatment. Toggled
     per-dot because the rail can straddle the hero/body boundary. */
  .section-nav a.on-pine .dot {
    border-color: oklch(1 0 0 / 0.55);
  }

  .section-nav a.on-pine:hover .dot,
  .section-nav a.on-pine:focus-visible .dot,
  .section-nav a.on-pine.is-active .dot {
    background-color: var(--hero-accent);
    border-color: var(--hero-accent);
  }

  .section-nav a.on-pine .label {
    color: oklch(1 0 0 / 0.68);
  }

  .section-nav a.on-pine:hover .label,
  .section-nav a.on-pine.is-active .label {
    color: var(--hero-text);
  }

  /* Transient label chip shown on mobile when the active section changes/taps.
     Has its own background so it stays legible while overlapping content. */
  .active-chip {
    display: none;
    position: absolute;
    right: 100%;
    margin-right: 0.5rem;
    transform: translateY(-50%) translateX(0.5rem);
    padding: 0.25rem 0.625rem;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-text);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .active-chip.is-visible {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* On wider screens: anchored rail with always-visible labels (default above).
     On narrow screens: keep a slim dots-only rail pinned to the right edge,
     and surface the section name via the transient chip instead of crowding. */
  @media (max-width: 1200px) {
    .section-nav {
      right: 0.75rem;
      /* Let the rail capture vertical gestures instead of scrolling the page. */
      touch-action: none;
    }

    .section-nav .label {
      display: none;
    }

    /* Labels are hidden here, so keep the dot pinned to the right edge of the
       wider tap target instead of floating it inward. */
    .section-nav a {
      justify-content: flex-end;
    }

    .active-chip {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot,
    .label,
    .active-chip {
      transition: none;
    }
  }
</style>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')
  );

  const linkById = new Map(
    links.map((link) => [link.dataset.sectionLink, link])
  );

  const sections = links
    .map((link) => document.getElementById(link.dataset.sectionLink ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  const chip = document.querySelector<HTMLElement>('[data-active-chip]');

  let activeId: string | null = null;
  let chipTimer: number | undefined;

  const showChip = (link: HTMLAnchorElement) => {
    if (!chip) return;
    const label = link.querySelector('.label')?.textContent ?? '';
    chip.textContent = label;
    // Align the chip vertically with the active dot (offsetTop is relative to
    // the fixed-positioned nav, which is the chip's offset parent).
    chip.style.top = `${link.offsetTop + link.offsetHeight / 2}px`;
    chip.classList.add('is-visible');
    window.clearTimeout(chipTimer);
    chipTimer = window.setTimeout(() => chip.classList.remove('is-visible'), 1800);
  };

  const setActive = (id: string) => {
    links.forEach((link) =>
      link.classList.toggle('is-active', link.dataset.sectionLink === id)
    );
    if (id !== activeId) {
      activeId = id;
      const link = links.find((l) => l.dataset.sectionLink === id);
      if (link) showChip(link);
    }
  };

  // Also reveal the chip when a dot is tapped directly.
  links.forEach((link) =>
    link.addEventListener('click', () => showChip(link))
  );

  // --- Scroll-wheel / swipe stepping over the rail (mobile) ---
  const nav = document.querySelector<HTMLElement>('.section-nav');
  const mobileQuery = window.matchMedia('(max-width: 1200px)');
  const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const sectionIds = links.map((l) => l.dataset.sectionLink ?? '');

  let isCoolingDown = false;
  let cooldownTimer: number | undefined;
  const cooldown = () => {
    isCoolingDown = true;
    window.clearTimeout(cooldownTimer);
    cooldownTimer = window.setTimeout(() => {
      isCoolingDown = false;
    }, 500);
  };

  // Notch one section in the given direction, like a scroll wheel.
  const step = (dir: number) => {
    const current = Math.max(0, sectionIds.indexOf(activeId ?? ''));
    const next = Math.min(sections.length - 1, Math.max(0, current + dir));
    if (next === current) return;
    cooldown();
    setActive(sectionIds[next]);
    sections[next].scrollIntoView({
      behavior: reducedMotionQuery.matches ? 'auto' : 'smooth',
      block: 'start',
    });
  };

  let wheelAccum = 0;
  nav?.addEventListener(
    'wheel',
    (e) => {
      if (!mobileQuery.matches) return;
      e.preventDefault();
      if (isCoolingDown) return;
      wheelAccum += e.deltaY;
      if (Math.abs(wheelAccum) >= 30) {
        step(wheelAccum > 0 ? 1 : -1);
        wheelAccum = 0;
      }
    },
    { passive: false }
  );

  let touchStartY: number | null = null;
  nav?.addEventListener(
    'touchstart',
    (e) => {
      touchStartY = e.touches[0]?.clientY ?? null;
    },
    { passive: true }
  );
  nav?.addEventListener(
    'touchmove',
    (e) => {
      if (!mobileQuery.matches || touchStartY === null) return;
      e.preventDefault();
      if (isCoolingDown) return;
      const currentY = e.touches[0]?.clientY ?? touchStartY;
      const delta = touchStartY - currentY;
      if (Math.abs(delta) >= 24) {
        step(delta > 0 ? 1 : -1);
        touchStartY = currentY;
      }
    },
    { passive: false }
  );
  nav?.addEventListener('touchend', () => {
    touchStartY = null;
  });

  // --- Flip individual rail dots to light styling while they overlap the
  // pine hero (the rail can straddle the hero/body boundary at the top). ---
  const heroEl = document.querySelector<HTMLElement>('.hero-section');
  const updateRailTheme = () => {
    if (!heroEl) return;
    const heroBottom = heroEl.getBoundingClientRect().bottom;
    links.forEach((link) => {
      const dot = link.querySelector('.dot');
      if (!dot) return;
      const r = dot.getBoundingClientRect();
      link.classList.toggle('on-pine', r.top + r.height / 2 < heroBottom);
    });
  };
  updateRailTheme();
  window.addEventListener('scroll', updateRailTheme, { passive: true });
  window.addEventListener('resize', updateRailTheme);

  const observer = new IntersectionObserver(
    (entries) => {
      // Ignore observer churn while we're programmatically stepping sections.
      if (isCoolingDown) return;
      // When the page is scrolled to the bottom, the last section may be too
      // short to reach the viewport's middle line, so force it active.
      if (isAtBottom()) {
        const last = sections[sections.length - 1];
        if (last) setActive(last.id);
        return;
      }

      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
        }
      });
    },
    {
      // Trigger when a section crosses the vertical middle of the viewport
      rootMargin: '-45% 0px -55% 0px',
      threshold: 0,
    }
  );

  const isAtBottom = () =>
    window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

  const handleScroll = () => {
    if (isAtBottom()) {
      const last = sections[sections.length - 1];
      if (last) setActive(last.id);
    }
  };

  sections.forEach((section) => observer.observe(section));
  window.addEventListener('scroll', handleScroll, { passive: true });

  // Anchor the rail at the top of the page: highlight the first section on
  // load so the rail never floats with every dot inactive. Skip the chip so
  // it doesn't flash on mobile page loads.
  if (window.scrollY < 40 && sectionIds[0]) {
    activeId = sectionIds[0];
    links.forEach((link) =>
      link.classList.toggle('is-active', link.dataset.sectionLink === sectionIds[0])
    );
  }
</script>
