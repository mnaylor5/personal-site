---
const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'publications', label: 'Publications' },
  { id: 'education', label: 'Education' },
];
---

<nav class="section-nav" aria-label="Page sections">
  <ul>
    {sections.map((section) => (
      <li>
        <a href={`#${section.id}`} data-section-link={section.id}>
          <span class="dot" aria-hidden="true"></span>
          <span class="label">{section.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .section-nav {
    position: fixed;
    top: 50%;
    /* Derive the rail offset from the widest section column so it can never
       collide with content. Single source of truth lives in global.css. */
    right: calc(50% + var(--content-wide) / 2 + var(--content-rail-gap));
    transform: translateY(-50%);
    z-index: 50;
  }

  .section-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .section-nav a {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.625rem;
    text-decoration: none;
    /* ≥44px tap target for the primary section navigation (WCAG 2.5.5). */
    min-height: 44px;
    min-width: 44px;
    padding: 0 0.25rem;
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 2px solid var(--color-text-muted);
    background-color: transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .section-nav a:hover .dot,
  .section-nav a:focus-visible .dot {
    border-color: var(--color-accent);
    transform: scale(1.15);
  }

  .section-nav a:hover .label,
  .section-nav a:focus-visible .label {
    color: var(--color-text);
  }

  .section-nav a.is-active .dot {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .section-nav a.is-active .label {
    color: var(--color-text);
    font-weight: 600;
  }

  /* Dots that currently overlap the deep-pine hero flip to light styling so
     they stay legible; the rest keep the dark-on-white treatment. Toggled
     per-dot because the rail can straddle the hero/body boundary. */
  .section-nav a.on-pine .dot {
    border-color: oklch(1 0 0 / 0.55);
  }

  .section-nav a.on-pine:hover .dot,
  .section-nav a.on-pine:focus-visible .dot,
  .section-nav a.on-pine.is-active .dot {
    background-color: var(--hero-accent);
    border-color: var(--hero-accent);
  }

  .section-nav a.on-pine .label {
    color: oklch(1 0 0 / 0.68);
  }

  .section-nav a.on-pine:hover .label,
  .section-nav a.on-pine.is-active .label {
    color: var(--hero-text);
  }

  /* The rail is a desktop scroll-spy enhancement. It only fits beside the
     centered column once the viewport is wide enough to clear it, so it stays
     dots-only from 1024–1200px and is hidden below that — on smaller screens
     the page is short enough to simply scroll. */
  @media (max-width: 1200px) {
    .section-nav .label {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .section-nav {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot,
    .label {
      transition: none;
    }
  }
</style>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')
  );

  const sections = links
    .map((link) => document.getElementById(link.dataset.sectionLink ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  const setActive = (id: string) => {
    links.forEach((link) =>
      link.classList.toggle('is-active', link.dataset.sectionLink === id)
    );
  };

  // Smooth-scroll to the section on dot click (respecting reduced motion).
  links.forEach((link) =>
    link.addEventListener('click', (e) => {
      const id = link.dataset.sectionLink ?? '';
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({
        behavior: reducedMotionQuery.matches ? 'auto' : 'smooth',
        block: 'start',
      });
      history.replaceState(null, '', `#${id}`);
    })
  );

  // Flip individual rail dots to light styling while they overlap the deep-pine
  // hero (the rail can straddle the hero/body boundary at the top).
  const heroEl = document.querySelector<HTMLElement>('.hero-section');
  const updateRailTheme = () => {
    if (!heroEl) return;
    const heroBottom = heroEl.getBoundingClientRect().bottom;
    links.forEach((link) => {
      const dot = link.querySelector('.dot');
      if (!dot) return;
      const r = dot.getBoundingClientRect();
      link.classList.toggle('on-pine', r.top + r.height / 2 < heroBottom);
    });
  };
  updateRailTheme();
  window.addEventListener('scroll', updateRailTheme, { passive: true });
  window.addEventListener('resize', updateRailTheme);

  const isAtBottom = () =>
    window.innerHeight + window.scrollY >=
    document.documentElement.scrollHeight - 2;

  // Scroll-spy: activate the section crossing the vertical middle of the
  // viewport, with a bottom-of-page guard for short trailing sections.
  const observer = new IntersectionObserver(
    (entries) => {
      if (isAtBottom()) {
        const last = sections[sections.length - 1];
        if (last) setActive(last.id);
        return;
      }
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: '-45% 0px -55% 0px', threshold: 0 }
  );

  sections.forEach((section) => observer.observe(section));

  const handleScroll = () => {
    if (isAtBottom()) {
      const last = sections[sections.length - 1];
      if (last) setActive(last.id);
    }
  };
  window.addEventListener('scroll', handleScroll, { passive: true });

  // Highlight the first section on load so the rail is never all-inactive.
  if (window.scrollY < 40 && links[0]) {
    setActive(links[0].dataset.sectionLink ?? '');
  }
</script>
