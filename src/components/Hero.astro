---
import { Image } from 'astro:assets';
import mitchPhoto from '../assets/mitch.jpg';

const socialLinks = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mitchnaylor/', external: true },
  { label: 'GitHub', href: 'https://www.github.com/mnaylor5', external: true },
  { label: 'Email', href: 'mailto:mitchnaylor94@gmail.com', external: false },
];
---

<header class="hero-section">
  <div class="max-w-4xl mx-auto px-6 pt-12 pb-8 flex flex-col items-center text-center">
    <div class="profile-photo-wrap animate-fade-in">
      <Image
        src={mitchPhoto}
        alt="Photo of Mitchell Naylor"
        width={320}
        height={320}
        format="webp"
        quality={80}
        class="profile-photo"
      />
    </div>

    <h1 class="hero-name animate-fade-in animate-delay-1">Mitchell Naylor</h1>
    <span class="hero-rule animate-fade-in animate-delay-2" aria-hidden="true"></span>
    <p class="hero-role animate-fade-in animate-delay-2">
      Member of Technical Staff · Cohere
    </p>
    <p class="hero-tagline animate-fade-in animate-delay-3">
      Post-training research for coding models.
    </p>

    <nav aria-label="Social links" class="mt-8 flex gap-5 animate-fade-in animate-delay-4">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          class="social-btn"
          {...link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
          aria-label={link.label}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .hero-section {
    background-color: var(--hero-bg);
    background-image: radial-gradient(
      120% 140% at 50% 0%,
      var(--hero-bg) 0%,
      var(--hero-bg-deep) 100%
    );
    color: var(--hero-text);
  }

  .hero-name {
    margin-top: 1.5rem;
    font-size: clamp(2.25rem, 3vw + 1.25rem, 3rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--hero-text);
  }

  .hero-rule {
    display: block;
    width: 2.5rem;
    height: 3px;
    margin: 1rem 0 0;
    border-radius: 9999px;
    background-color: var(--hero-accent);
  }

  .hero-role {
    margin-top: 1rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--hero-text);
  }

  .hero-tagline {
    margin-top: 0.4rem;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--hero-text-muted);
    text-wrap: balance;
  }

  .profile-photo-wrap {
    width: 160px;
    height: 160px;
  }

  .profile-photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 3px solid oklch(1 0 0 / 0.9);
    box-shadow: 0 0 0 1px var(--hero-border), 0 12px 32px oklch(0 0 0 / 0.35);
  }

  .social-btn {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--hero-border);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: oklch(0.92 0.02 160);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .social-btn:hover {
    color: var(--hero-text);
    border-color: var(--hero-accent);
    background-color: var(--hero-surface);
    text-decoration: none;
  }

  .social-btn:focus-visible {
    outline-color: var(--hero-accent);
  }
</style>
